{
  "manifest_version": 3,
  "name": "Paperwise — Form companion",
  "version": "1.0.0",
  "description": "A guided companion beside website forms. Review and fill one field at a time.",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "action": { "default_title": "Open Paperwise", "default_icon": { "48": "icon48.png", "128": "icon128.png" } },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "48": "icon48.png", "128": "icon128.png" }
}
