{
  "name": "paperwise",
  "description": "Fill any web form by voice, in your language.",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare && node scripts/copy-voice-assets.mjs && node scripts/copy-pdf-assets.mjs",
    "server": "pnpm --dir server dev",
    "check": "pnpm compile && pnpm --dir server typecheck && pnpm build",
    "build:test-pages": "node scripts/build-test-pages.mjs",
    "test:fill": "node scripts/test-fill.mjs",
    "test:reach": "node scripts/test-reach.mjs",
    "scan:test-forms": "node scripts/scan-test-forms.mjs",
    "test:state": "tsx scripts/test-state.ts",
    "test:voice": "tsx scripts/test-voice.ts",
    "test:pdf": "tsx scripts/test-pdf.ts",
    "test:a11y": "node scripts/test-a11y.mjs",
    "demo:check": "tsx scripts/demo-check.ts",
    "pdf:labels": "tsx scripts/pdf-labels.ts",
    "build:test-pdfs": "node scripts/build-test-pdfs.mjs"
  },
  "dependencies": {
    "@alexanderolsen/libsamplerate-js": "2.1.2",
    "@elevenlabs/client": "1.30.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "axe-core": "4.11.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wxt": "^0.21.4"
  }
}
