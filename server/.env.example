# Copy to server/.env and fill in. Never commit .env.
PORT=8787

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models before changing.
# gemini-3.5-flash-lite maps a form in ~8 s; gemini-3.8-flash is nicer but was 30–110 s (2026-10-24).
GEMINI_MODEL=gemini-3.5-flash-lite
# Form map: after this many ms the user gets the keyword fallback (Gemini still fills the cache)
FORM_MAP_TIMEOUT_MS=15000
# Your key's requests-per-minute limit. Free tier flash-lite = 15 (a form costs ~4 requests).
# A paid key (Tier 1+) allows far more: set it here and the form map gets hedging + prewarm room.
GEMINI_RPM=15
# A form-map part not answered after this many ms gets a twin request (first answer wins). 0 = off.
FORM_MAP_HEDGE_MS=2500

# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Created by `pnpm --dir server agent:setup` (it prints the id). Auth is enabled by the script.
ELEVENLABS_AGENT_ID=
# Optional, for agent:setup: a warm multilingual voice from your Voice Library (default: ElevenLabs' default voice)
ELEVENLABS_VOICE_ID=
# Agent LLM, for agent:setup. Fastest that passed the full voice test (see CLAUDE.md)
ELEVENLABS_LLM=claude-haiku-4-5
# on = the user (or noise) can cut the agent off mid-sentence. Off by default (crowded rooms).
# Change it, then run: pnpm --dir server agent:setup
ELEVENLABS_INTERRUPTIONS=off
